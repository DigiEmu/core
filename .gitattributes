# Always store text as LF in the repo (prevents gofmt/check churn on Windows)
* text=auto eol=lf

# keep JSON + lock stable across OS/runners
*.json   text eol=lf
*.sha256 text eol=lf

# scripts + workflows
*.ps1    text eol=lf
*.sh     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# source
*.go     text eol=lf
*.md     text eol=lf